{
  "$schema": "https://opencode.ai/config.json",
  "lsp": {
    "vue_ls": {
      "command": ["npx", "-y", "@vue/language-server", "--stdio"],
      "extensions": [".vue"],
      "initialization": {
        "typescript": {
          "tsdk": "node_modules/typescript/lib"
        }
      }
    },
    "ts_ls": {
      "command": ["npx", "-y", "typescript-language-server", "--stdio"],
      "extensions": [".js", ".jsx", ".ts", ".tsx"],
      "initialization": {
        "plugins": [
          {
            "name": "@vue/typescript-plugin",
            "location": "node_modules/@vue/language-server",
            "languages": ["javascript", "typescript", "vue"]
          }
        ]
      }
    }
  },
  "mcp": {
    "kindly-web-search": {
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "git+https://github.com/Shelpuk-AI-Technology-Consulting/kindly-web-search-mcp-server",
        "kindly-web-search-mcp-server",
        "start-mcp-server"
      ],
      "enabled": true,
      "env": {
        "SEARXNG_BASE_URL": "${SEARXNG_BASE_URL}",
        "GITHUB_TOKEN": "${GITHUB_TOKEN}"
      }
    }
  }
}
