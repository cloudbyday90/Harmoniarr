{
  "name": "harmoniarr",
  "version": "0.1.0-beta",
  "private": true,
  "packageManager": "npm@12.0.2",
  "type": "module",
  "description": "Soulseek-native music library manager inspired by Lidarr",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=24.15.0 <25.0.0",
    "npm": ">=12.0.2 <13.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.15.0 <25.0.0",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=12.0.2 <13.0.0",
      "onFail": "warn"
    }
  },
  "scripts": {
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build --config vite.config.js",
    "build:server": "node scripts/build-server.js",
    "check-copyright": "node scripts/check-copyright.js",
    "check:esm": "node scripts/check-esm-consistency.js",
    "check:image-tags": "node scripts/check-compose-image-tags.js",
    "check:migration-id-policy": "node scripts/check-migration-id-policy.js",
    "check:migrations": "node dist/server/check-migrations.js",
    "check:migration-checksums": "node dist/server/check-migration-checksums.js",
    "check:schema-anchors": "node scripts/check-schema-anchors.js",
    "check:schema-snapshot": "node scripts/check-schema-snapshot.js",
    "check:test-hygiene": "node scripts/check-test-hygiene.js",
    "db:check-schema": "node scripts/check-database-schema.js",
    "db:dump-schema": "node scripts/update-schema-snapshot.js",
    "diagnose:migrations": "node scripts/diagnose-migrations.js",
    "generate:vapid-keys": "node scripts/generate-vapid-keys.js",
    "lint": "npm run lint:server && npm run lint:shared && npm run lint:client && npm run lint:test && npm run lint:scripts",
    "lint:client": "eslint --cache --max-warnings 0 --report-unused-disable-directives \"src/client/**/*.js\" \"src/client/**/*.vue\"",
    "lint:scripts": "eslint --cache --max-warnings 0 --report-unused-disable-directives \"scripts/**/*.js\" \"eslint.config.js\" \"vite.config.js\"",
    "lint:server": "eslint --cache --max-warnings 0 --report-unused-disable-directives \"src/server/**/*.js\"",
    "lint:shared": "eslint --cache --max-warnings 0 --report-unused-disable-directives \"src/shared/**/*.js\"",
    "lint:test": "eslint --cache --max-warnings 0 --report-unused-disable-directives \"test/**/*.js\" \"testing/**/*.js\"",
    "migration:check": "node scripts/check-migration-filenames.js && node scripts/check-migration-id-policy.js",
    "migration:create": "node scripts/create-migration.js",
    "migrate": "node dist/server/migrate.js",
    "prepare:database": "node dist/server/prepare-database.js",
    "probe:release-mirror-capabilities": "node scripts/probe-release-mirror-capabilities.js",
    "promote:release-mirror-trust": "node scripts/promote-release-mirror-trust.js",
    "start": "node dist/server/index.js",
    "test": "npm run lint && npm run check:test-hygiene && npm run test:node",
    "test:browser": "npm run build:client && npx playwright install chromium && node --test --test-concurrency=1 \"test/browser/**/*.test.js\"",
    "test:client": "node --test \"test/client/**/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage",
    "test:integration": "node --test --test-concurrency=1 \"test/integration/**/*.test.js\"",
    "test:node": "npm run test:server && npm run test:client && npm run test:scripts && npm run test:integration",
    "test:scripts": "node --test \"test/scripts/**/*.test.js\" \"test/compose-image-tag-policy.test.js\"",
    "test:server": "node --test \"test/server/**/*.test.js\"",
    "update:schema-snapshot": "node scripts/update-schema-snapshot.js",
    "validate": "npm run check-copyright && npm run migration:check && npm run check:schema-snapshot && npm run check:esm && npm run check:image-tags && npm test && npm run build",
    "validate:docker-fresh-install": "node scripts/validate-docker-fresh-install.js",
    "validate:docker-deployment-path": "node scripts/validate-docker-deployment-path.js",
    "validate:docker-file-backed-music-queue": "node scripts/validate-docker-file-backed-music-queue.js",
    "validate:docker-controlled-provider-pipeline": "node scripts/validate-docker-controlled-provider-pipeline.js",
    "validate:docker-provider-acceptance": "node scripts/validate-docker-provider-acceptance.js",
    "validate:managed-slskd-smoke": "node scripts/validate-managed-slskd-smoke.js",
    "validate:docker-upgrade": "node scripts/validate-docker-upgrade.js",
    "validate:docker-released-image": "node scripts/validate-docker-released-image.js",
    "validate:docker-browser-smoke": "node scripts/validate-docker-browser-smoke.js",
    "validate:release-evidence-pack": "node scripts/validate-release-evidence-pack.js",
    "validate:docker-smoke-evidence": "node scripts/verify-docker-smoke-evidence.js",
    "write:docker-deployment-summary": "node scripts/write-docker-deployment-summary.js",
    "validate:release-contract": "node scripts/verify-release-contract.js",
    "validate:release-mirror-referrers": "node scripts/verify-release-mirror-referrers.js",
    "validate:schema-bootstrap": "node scripts/validate-schema-bootstrap.js",
    "validate:security": "npm run check:image-tags && npm run validate:security:npm",
    "validate:security:npm": "node scripts/check-npm-audit.js",
    "wait:database": "node scripts/wait-for-postgres.js",
    "write:issue-4-evidence-map": "node scripts/render-issue-4-release-evidence-map.js",
    "validate:database": "npm run wait:database && npm run build:server && npm run prepare:database && npm run validate:schema-bootstrap",
    "update-copyright": "node scripts/update-copyright.js",
    "add-copyright-headers": "node scripts/add-copyright-headers.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testcontainers/postgresql": "^12.1.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/language-server": "^3.3.9",
    "@vue/typescript-plugin": "^3.3.1",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.10.0",
    "glob": "^13.0.6",
    "globals": "^17.9.0",
    "playwright": "^1.62.1",
    "typescript": "^6.0.3",
    "typescript-language-server": "^5.3.0",
    "vite": "^8.2.1"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "uuid": "^11.1.1"
  },
  "dependencies": {
    "express": "^5.2.1",
    "music-metadata": "^11.15.0",
    "pg": "^8.23.0",
    "sharp": "^0.35.3",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0",
    "web-push": "^3.6.7"
  }
}
