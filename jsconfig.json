{
  "compilerOptions": {
    "baseUrl": ".",
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "paths": {
      "@/*": [
        "src/client/*"
      ]
    }
  },
  "include": [
    "src/client/**/*.js",
    "src/client/**/*.vue"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
