# Harmoniarr deployment environment template
# Copy this file to .env and adjust values for your host.

# Container user selection and default file-creation behavior
TZ=UTC
PUID=1000
PGID=1000
UMASK=0022

# HTTP exposure
APP_PORT=3000
HARMONIARR_PORT=47956
HARMONIARR_BASE_URL=
HARMONIARR_CONTACT_URL=https://github.com/cloudbyday90/harmoniarr
HARMONIARR_CONTACT_EMAIL=
HARMONIARR_LOG_LEVEL=info
HARMONIARR_CSRF_PROTECTION=required

# Web Push VAPID identity
# Generate once with: npm run generate:vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:admin@example.com

# Persistent application state
HARMONIARR_APPDATA=/srv/harmoniarr

# Shared media and workflow paths
# Prefer keeping the slskd download tree mounted at the same in-container
# path that Harmoniarr sees: /data/downloads
HARMONIARR_DOWNLOADS=/srv/slskd/downloads
HARMONIARR_MUSIC=/srv/media/music
HARMONIARR_STAGING=/srv/harmoniarr/staging
HARMONIARR_TRANSCODE_TEMP=/srv/harmoniarr/transcode-temp

# Optional paired slskd example values
SLSKD_BASE_URL=http://slskd:5030
SLSKD_API_KEY=
SLSKD_REQUEST_TIMEOUT_MS=10000
SLSKD_WEB_PORT=5030
SLSKD_APPDATA=/srv/slskd/config

# Metadata provider defaults
MUSICBRAINZ_BASE_URL=https://musicbrainz.org/ws/2
MUSICBRAINZ_MIN_INTERVAL_MS=1100
MUSICBRAINZ_REQUEST_TIMEOUT_MS=10000
MUSICBRAINZ_MAX_RETRIES=2
